generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SemanticCache {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_text    String
  embedding        Unsupported("vector")
  answer_text      String
  answer_audio_url String?
  hit_count        Int?                  @default(0)
  last_used_at     DateTime?             @db.Timestamp(6)
  source           String?               @default("website") @db.VarChar(50)
  created_at       DateTime?             @default(now()) @db.Timestamp(6)
  updated_at       DateTime?             @default(now()) @db.Timestamp(6)

  @@index([embedding])
  @@map("semantic_cache")
}

model audit_logs {
  id         Int       @id @default(autoincrement())
  table_name String?   @db.VarChar(50)
  record_id  Int?
  action     String?   @db.VarChar(10)
  field_name String?   @db.VarChar(50)
  old_value  String?
  new_value  String?
  changed_by Int?
  changed_at DateTime? @db.Timestamp(6)
  users      users?    @relation(fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model cart_items {
  cart_item_id Int       @id @default(autoincrement())
  cart_id      Int?
  product_id   Int?
  quantity     Int?
  added_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  carts        carts?    @relation(fields: [cart_id], references: [cart_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cart_id, product_id], map: "uq_cart_product")
}

model carts {
  cart_id    Int          @id @default(autoincrement())
  user_id    Int
  status     String?      @db.VarChar(20)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @default(now()) @db.Timestamp(6)
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  orders     orders[]
}

model consumption_history {
  id            Int       @id @default(autoincrement())
  product_id    Int?
  date          DateTime? @db.Timestamp(6)
  department    String?   @db.VarChar
  quantity_used Int?
  consumed_by   Int?
  created_at    DateTime? @db.Timestamp(6)
  products      products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
}

model forecasts {
  id                 Int       @id @default(autoincrement())
  item_id            Int?
  user_id            Int?
  forecast_date      DateTime? @db.Date
  week               DateTime? @db.Date
  predicted_quantity Float?
  actual_quantity    Float?
  created_at         DateTime? @db.Timestamp(6)
  confidence_score   Float?
  items              items?    @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
  users              users?    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model historical_data {
  id               Int       @id @default(autoincrement())
  item_id          Int?
  user_id          Int?
  week             DateTime? @db.Date
  patient_footfall Int?
  last_week_usage  Int?
  public_holiday   Boolean?
  rain_impact      Boolean?
  quantity_used    Int?
  recorded_at      DateTime? @default(now()) @db.Timestamp(6)
  items            items?    @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction)
  users            users?    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model invites {
  id         Int       @id @default(autoincrement())
  code       String?   @unique @db.VarChar(12)
  is_admin   Boolean?
  used       Boolean?
  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [created_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model items {
  item_id         Int               @id @default(autoincrement())
  item_code       String?           @db.VarChar(20)
  description     String?           @db.VarChar(100)
  department      String?           @db.VarChar(50)
  user_id         Int
  unit_price      Float?
  category        String?           @db.VarChar(50)
  current_stock   Int?
  lead_time       Int?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  forecasts       forecasts[]
  historical_data historical_data[]
  users           users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([item_code, user_id], map: "uq_item_user")
  @@index([item_code], map: "ix_items_item_code")
  @@index([item_id], map: "ix_items_item_id")
}

model order_items {
  order_item_id Int     @id @default(autoincrement())
  order_id      Int?
  product_id    Int?
  quantity      Int?
  unit_price    Float?
  total_price   Float?
  orders        orders? @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  order_id                        Int           @id @default(autoincrement())
  user_id                         Int?
  cart_id                         Int?
  status                          String?       @db.VarChar(20)
  total_amount                    Float?
  notes                           String?
  approved_by                     Int?
  approved_at                     DateTime?     @db.Timestamp(6)
  created_at                      DateTime?     @default(now()) @db.Timestamp(6)
  updated_at                      DateTime?     @default(now()) @db.Timestamp(6)
  order_items                     order_items[]
  users_orders_approved_byTousers users?        @relation("orders_approved_byTousers", fields: [approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  carts                           carts?        @relation(fields: [cart_id], references: [cart_id], onDelete: NoAction, onUpdate: NoAction)
  users_orders_user_idTousers     users?        @relation("orders_user_idTousers", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model otps {
  id         Int       @id @default(autoincrement())
  email      String?   @db.VarChar
  mobile     String?   @db.VarChar(15)
  otp_code   String?   @db.VarChar(6)
  otp_type   String?   @db.VarChar(20)
  is_used    Boolean?
  expires_at DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([email], map: "ix_otps_email")
  @@index([mobile], map: "ix_otps_mobile")
}

model product_suppliers {
  product_supplier_id Int        @id @default(autoincrement())
  product_id          Int?
  supplier_id         Int?
  last_purchase_price Float?
  currency            String?    @db.VarChar(10)
  lead_time_days      Int?
  min_order_qty       Int?
  is_preferred        Boolean?
  is_active           Boolean?
  created_at          DateTime?  @default(now()) @db.Timestamp(6)
  updated_at          DateTime?  @default(now()) @db.Timestamp(6)
  products            products?  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  suppliers           suppliers? @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, supplier_id], map: "uq_product_supplier")
}

model product_vendors {
  product_vendor_id         Int       @id @default(autoincrement())
  product_id                Int
  vendor_id                 Int
  vendor_product_code       String?   @db.VarChar(50)
  vendor_product_name       String?   @db.VarChar(255)
  last_purchase_price       Float?
  currency                  String?   @default("INR") @db.Char(3)
  lead_time_days            Int?
  min_order_qty             Int?
  preferred_vendor          Boolean?  @default(false)
  rating                    Decimal?  @db.Decimal(3, 2)
  remarks                   String?
  supplier_specs            Json?     @default("{}")
  supplier_specs_version    String?   @db.VarChar(32)
  supplier_specs_updated_at DateTime? @default(now()) @db.Timestamp(6)
  is_active                 Boolean?  @default(true)
  created_by                Int?
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @default(now()) @db.Timestamp(6)
  created_by_a              String?   @db.VarChar(50)
  created_on_a              DateTime? @default(now()) @db.Timestamp(6)
  created_ip_a              String?   @db.VarChar(45)
  modified_by_a             String?   @db.VarChar(50)
  modified_on_a             DateTime? @db.Timestamp(6)
  modified_ip_a             String?   @db.VarChar(45)

  @@unique([product_id, vendor_id], map: "uniq_product_vendor")
}

model products {
  product_id          Int                   @id @default(autoincrement())
  name                String?               @db.VarChar(100)
  description         String?
  category            String?               @db.VarChar(50)
  image_url           String?               @db.VarChar
  is_active           Boolean?
  created_by          Int?
  hsn_code            String?               @db.VarChar(15)
  hsn_description     String?
  specs               Json?                 @db.Json
  specs_version       String?               @db.VarChar(32)
  specs_updated_at    DateTime?             @default(now()) @db.Timestamp(6)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  created_by_a        String?               @db.VarChar(50)
  created_on_a        DateTime?             @default(now()) @db.Timestamp(6)
  created_ip_a        String?               @db.VarChar(45)
  modified_by_a       String?               @db.VarChar(50)
  modified_on_a       DateTime?             @db.Timestamp(6)
  modified_ip_a       String?               @db.VarChar(45)
  consumption_history consumption_history[]
  product_suppliers   product_suppliers[]
  users               users?                @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  stock_ledger        stock_ledger[]

  @@index([product_id], map: "ix_products_product_id")
}

model requisition_header {
  req_id           Int                @id @default(autoincrement())
  tenant_id        Int
  company_id       Int
  document_type    String?            @db.VarChar(100)
  requisition_no   Int
  revision_no      Int?
  requisition_date DateTime           @db.Date
  department       String?            @db.VarChar(150)
  requester_id     Int
  status           String?            @db.VarChar(50)
  priority         String?            @db.VarChar(50)
  source_type      String?            @db.VarChar(100)
  remarks          String?            @db.VarChar(500)
  approved_by      Int?
  approved_at      DateTime?          @db.Timestamptz(6)
  rejected_by      Int?
  rejected_at      DateTime?          @db.Timestamptz(6)
  rejection_reason String?            @db.VarChar(500)
  pr_generated     Boolean?
  pr_generated_at  DateTime?          @db.Timestamptz(6)
  po_generated     Boolean?
  po_generated_at  DateTime?          @db.Timestamptz(6)
  created_by       Int
  updated_by       Int?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  requisition_line requisition_line[]

  @@index([req_id], map: "ix_requisition_header_req_id")
}

model requisition_line {
  line_id                Int                @id @default(autoincrement())
  tenant_id              Int
  company_id             Int
  req_id                 Int
  line_no                Int
  item_id                Int?
  item_no                String?            @db.VarChar(100)
  description            String?            @db.VarChar(500)
  uom                    String?            @db.VarChar(50)
  qty_requested          Decimal            @db.Decimal(18, 2)
  qty_predicted          Decimal?           @db.Decimal(18, 2)
  qty_issued             Decimal?           @db.Decimal(18, 2)
  last_unit_price        Decimal?           @db.Decimal(18, 2)
  estimated_total_amount Decimal?           @db.Decimal(18, 2)
  preferred_supplier_id  Int?
  lead_time_days         Int?
  expected_delivery_date DateTime?          @db.Date
  line_status            String?            @db.VarChar(50)
  pr_line_id             Int?
  po_line_id             Int?
  remarks                String?            @db.VarChar(500)
  attachment_count       Int?
  created_by             Int
  updated_by             Int?
  created_at             DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?          @default(now()) @db.Timestamptz(6)
  requisition_header     requisition_header @relation(fields: [req_id], references: [req_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([line_id], map: "ix_requisition_line_line_id")
}

model rfq_header {
  tenant_id        Int
  company_id       Int
  document_type    String       @db.VarChar(100)
  rfq_no           String       @db.VarChar(30)
  version_no       Int          @default(1)
  rfq_date         DateTime     @db.Date
  department_id    Int?
  requester_id     Int
  status           String?      @db.VarChar(50)
  priority         String?      @db.VarChar(50)
  source_type      String?      @db.VarChar(100)
  remarks          String?      @db.VarChar(500)
  approved_by      Int?
  approved_at      DateTime?    @db.Timestamptz(6)
  rejected_by      Int?
  rejected_at      DateTime?    @db.Timestamptz(6)
  rejection_reason String?      @db.VarChar(500)
  created_by       Int
  updated_by       Int?
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?    @default(now()) @db.Timestamptz(6)
  document_number  String?      @db.VarChar(200)
  rfq_id           Int          @unique(map: "uq_rfq_header_rfq_id") @default(autoincrement())
  rfq_line         rfq_line[]
  rfq_vendor       rfq_vendor[]

  @@id([tenant_id, company_id, document_type, rfq_no, version_no], map: "pk_rfq_header")
  @@index([tenant_id, company_id, rfq_date], map: "idx_rfq_date")
  @@index([tenant_id, company_id, status], map: "idx_rfq_status")
  @@index([tenant_id, company_id], map: "idx_rfq_tenant_company")
}

model rfq_line {
  tenant_id        Int
  company_id       Int
  document_type    String     @db.VarChar(100)
  rfq_no           String     @db.VarChar(30)
  version_no       Int
  line_no          Int
  item_id          Int?
  item_description String?    @db.VarChar(500)
  uom              String?    @db.VarChar(50)
  quantity         Decimal    @db.Decimal(18, 4)
  estimated_rate   Decimal?   @db.Decimal(18, 4)
  estimated_amount Decimal?   @db.Decimal(18, 4)
  required_date    DateTime?  @db.Date
  remarks          String?    @db.VarChar(500)
  created_by       Int
  created_at       DateTime?  @default(now()) @db.Timestamptz(6)
  updated_by       Int?
  updated_at       DateTime?  @default(now()) @db.Timestamptz(6)
  rfq_header       rfq_header @relation(fields: [tenant_id, company_id, document_type, rfq_no, version_no], references: [tenant_id, company_id, document_type, rfq_no, version_no], onDelete: Cascade, map: "fk_rfq_line_header")

  @@id([tenant_id, company_id, document_type, rfq_no, version_no, line_no], map: "pk_rfq_line")
  @@index([tenant_id, company_id, rfq_no], map: "idx_rfq_line_header")
  @@index([tenant_id, company_id, item_id], map: "idx_rfq_line_item")
}

model rfq_vendor {
  tenant_id     Int
  company_id    Int
  document_type String     @db.VarChar(100)
  rfq_no        String     @db.VarChar(30)
  version_no    Int
  vendor_id     Int
  created_by    Int
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_by    Int?
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)
  rfq_header    rfq_header @relation(fields: [tenant_id, company_id, document_type, rfq_no, version_no], references: [tenant_id, company_id, document_type, rfq_no, version_no], onDelete: Cascade, map: "fk_rfq_vendor_header")

  @@id([tenant_id, company_id, document_type, rfq_no, version_no, vendor_id], map: "pk_rfq_vendor")
  @@index([tenant_id, company_id, vendor_id], map: "idx_rfq_vendor_vendor")
}

model stock_ledger {
  id               Int       @id @default(autoincrement())
  product_id       Int?
  date             DateTime? @db.Timestamp(6)
  transaction_type String?   @db.VarChar
  quantity         Int?
  balance_after    Int?
  reference        String?   @db.VarChar
  created_at       DateTime? @db.Timestamp(6)
  updated_at       DateTime? @db.Timestamp(6)
  products         products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
}

model suppliers {
  supplier_id       Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  email             String?             @db.VarChar(255)
  phone             String?             @db.VarChar(50)
  address           String?
  gst_number        String?             @db.VarChar(50)
  contact_person    String?             @db.VarChar(100)
  is_active         Boolean?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  product_suppliers product_suppliers[]

  @@index([supplier_id], map: "ix_suppliers_supplier_id")
}

model users {
  user_id                          Int               @id @default(autoincrement())
  email                            String?           @unique(map: "ix_users_email") @db.VarChar
  hashed_password                  String?           @db.VarChar
  role                             String?           @db.VarChar
  is_active                        Boolean?
  created_at                       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at                       DateTime?         @db.Timestamp(6)
  vendor_id                        Int?
  created_by_a                     String?           @db.VarChar(50)
  created_on_a                     DateTime?         @default(now()) @db.Timestamp(6)
  created_ip_a                     String?           @db.VarChar(45)
  modified_by_a                    String?           @db.VarChar(50)
  modified_on_a                    DateTime?         @db.Timestamp(6)
  modified_ip_a                    String?           @db.VarChar(45)
  audit_logs                       audit_logs[]
  carts                            carts[]
  forecasts                        forecasts[]
  historical_data                  historical_data[]
  invites                          invites[]
  items                            items[]
  orders_orders_approved_byTousers orders[]          @relation("orders_approved_byTousers")
  orders_orders_user_idTousers     orders[]          @relation("orders_user_idTousers")
  products                         products[]
  vendors                          vendors?          @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "ix_users_user_id")
}

model vendor_banks {
  id             Int       @id @default(autoincrement())
  vendor_id      Int
  bank_name      String    @db.VarChar(255)
  account_number String    @db.VarChar(50)
  ifsc_code      String    @db.VarChar(20)
  branch_name    String    @db.VarChar(100)
  account_type   String    @db.VarChar(20)
  is_primary     Boolean?
  created_at     DateTime? @db.Timestamp(6)
  updated_at     DateTime? @db.Timestamp(6)
  created_by     String?   @db.VarChar(50)
  created_on     DateTime? @default(now()) @db.Timestamp(6)
  created_ip     String?   @db.VarChar(45)
  modified_by    String?   @db.VarChar(50)
  modified_on    DateTime? @db.Timestamp(6)
  modified_ip    String?   @db.VarChar(45)
  tenant_id      String?   @db.VarChar(50)
  company_code   String?   @db.VarChar(50)
  vendors        vendors   @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_vendor_banks_id")
}

model vendor_documents {
  id              Int       @id @default(autoincrement())
  vendor_id       Int?
  document_type   String?   @db.VarChar(100)
  document_number String?   @db.VarChar(100)
  issue_date      DateTime? @db.Date
  expiry_date     DateTime? @db.Date
  document_path   String?   @db.VarChar(255)
  status          String?   @db.VarChar(20)
  uploaded_at     DateTime? @default(now()) @db.Timestamp(6)
  created_by      String?   @db.VarChar(50)
  created_on      DateTime? @default(now()) @db.Timestamp(6)
  created_ip      String?   @db.VarChar(45)
  modified_by     String?   @db.VarChar(50)
  modified_on     DateTime? @db.Timestamp(6)
  modified_ip     String?   @db.VarChar(45)
  tenant_id       String?   @db.VarChar(50)
  company_code    String?   @db.VarChar(50)
  vendors         vendors?  @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_vendor_documents_id")
}

model vendor_items {
  id           Int            @id @default(autoincrement())
  vendor_id    Int?
  item_name    String?        @db.VarChar(255)
  item_type    String?        @db.VarChar(50)
  uom          String?        @db.VarChar(50)
  description  String?
  created_by   String?        @db.VarChar(50)
  created_on   DateTime?      @default(now()) @db.Timestamp(6)
  created_ip   String?        @db.VarChar(45)
  modified_by  String?        @db.VarChar(50)
  modified_on  DateTime?      @db.Timestamp(6)
  modified_ip  String?        @db.VarChar(45)
  tenant_id    String?        @db.VarChar(50)
  company_code String?        @db.VarChar(50)
  vendors      vendors?       @relation(fields: [vendor_id], references: [vendor_id], onDelete: NoAction, onUpdate: NoAction)
  vendor_rates vendor_rates[]

  @@index([id], map: "ix_vendor_items_id")
}

model vendor_rates {
  id           Int           @id @default(autoincrement())
  item_id      Int?
  rate         Decimal?      @db.Decimal(12, 2)
  currency     String?       @db.VarChar(10)
  valid_from   DateTime?     @db.Date
  valid_to     DateTime?     @db.Date
  status       String?       @db.VarChar(20)
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  created_by   String?       @db.VarChar(50)
  created_on   DateTime?     @default(now()) @db.Timestamp(6)
  created_ip   String?       @db.VarChar(45)
  modified_by  String?       @db.VarChar(50)
  modified_on  DateTime?     @db.Timestamp(6)
  modified_ip  String?       @db.VarChar(45)
  tenant_id    String?       @db.VarChar(50)
  company_code String?       @db.VarChar(50)
  vendor_items vendor_items? @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_vendor_rates_id")
}

model vendors {
  vendor_id        Int                @id @default(autoincrement())
  email            String?            @db.VarChar
  mobile           String?            @db.VarChar(15)
  company_name     String?            @db.VarChar(255)
  vendor_type      String?            @db.VarChar(50)
  gst_number       String?            @db.VarChar(50)
  pan_number       String?            @db.VarChar(50)
  contact_person   String?            @db.VarChar(100)
  address_line1    String?            @db.VarChar(255)
  address_line2    String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  state            String?            @db.VarChar(100)
  country          String?            @db.VarChar(100)
  postal_code      String?            @db.VarChar(20)
  is_branch        Boolean?
  parent_vendor_id Int?
  status           String?            @db.VarChar(20)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  created_by_a     String?            @db.VarChar(50)
  created_on_a     DateTime?          @default(now()) @db.Timestamp(6)
  created_ip_a     String?            @db.VarChar(45)
  modified_by_a    String?            @db.VarChar(50)
